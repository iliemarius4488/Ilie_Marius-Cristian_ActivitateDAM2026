<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F1FA"
    android:fillViewport="true"
    tools:context=".AdaugareCinemaAI">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TextView: titlu -->
        <TextView
            android:id="@+id/tvTitlu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cinematograf nou"
            android:textColor="#2B1B5A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Completeaza detaliile de mai jos"
            android:textColor="#6B6580"
            android:textSize="14sp" />

        <!-- Card 1: informatii generale -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Informatii generale"
                    android:textColor="#5B3FD1"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- EditText: nume -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Numele cinematografului">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Gen film principal"
                    android:textColor="#6B6580"
                    android:textSize="13sp" />

                <!-- Spinner: gen -->
                <Spinner
                    android:id="@+id/spinnerGen"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/genuri_filme" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Tip sala"
                    android:textColor="#6B6580"
                    android:textSize="13sp" />

                <!-- RadioButton: tip sala -->
                <RadioGroup
                    android:id="@+id/rgTipSala"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbStandard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Standard" />

                    <RadioButton
                        android:id="@+id/rbImax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="IMAX" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: facilitati -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Facilitati"
                    android:textColor="#5B3FD1"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- CheckBox: parcare -->
                <CheckBox
                    android:id="@+id/cbParcare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Are parcare" />

                <!-- Switch: 3D -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAre3D"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Proiectii 3D" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 3: rating -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rating"
                    android:textColor="#5B3FD1"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- RatingBar: rating -->
                <RatingBar
                    android:id="@+id/ratingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:numStars="5"
                    android:stepSize="0.5" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Button: salvare -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalveaza"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:onClick="salveaza"
            android:text="Salveaza cinematograful"
            android:textSize="16sp"
            app:cornerRadius="30dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>
</ScrollView>